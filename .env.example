# Environment Variables
# Set these in your `.env.local` file (local development) or in the Vercel dashboard
# (Production / Preview). Never commit `.env.local` to git.
#
# ─── Required — Supabase ──────────────────────────────────────────────────
# Supabase is used to store booking records so the admin dashboard can track all
# inquiries in one place.
#
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# ─── Required — Booking email (Resend) ───────────────────────────────────
# Resend sends booking confirmation emails. Use a sandbox key for development
# (from: onboarding@resend.dev) and a production key when you have a verified domain.
#
# RESEND_API_KEY=re_your_key
#
# ─── Required — Admin authentication ─────────────────────────────────────
# The admin dashboard protects endpoints with a simple password + cookie session.
# Set any strong password you want — this is hashed and stored in a cookie.
#
# ADMIN_PASSWORD=your-admin-password
#
# ─── Optional ────────────────────────────────────────────────────────────
# Base URL for the deployed site (used in email links, etc.)
# NEXT_PUBLIC_SITE_URL=https://ethio-journey.vercel.app
#
# Google Gemini API key for the AI Concierge chat feature.
# GEMINI_API_KEY=your-gemini-key
